{
  "name": "norman-tools",
  "version": "2.0.0",
  "private": true,
  "description": "Free, open-source mini-tools for freelancers and small businesses in Germany — invoicing, e-invoices, tax letters, and tax estimates",
  "license": "MIT",
  "author": "Norman AI GmbH",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers@3": {
        "peerDependencies": {
          "zod": "*"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:tax-calculator": "pnpm --filter tax-calculator dev",
    "dev:e-invoice-generator": "pnpm --filter e-invoice-generator dev",
    "dev:tax-letter-assistant": "pnpm --filter tax-letter-assistant dev",
    "dev:invoice-generator": "pnpm --filter invoice-generator dev",
    "dev:steuer-check": "pnpm --filter steuer-check dev"
  }
}
